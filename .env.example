# Copier ce fichier vers .env et adapter les valeurs (.env n'est pas versionné).
# Les variables déjà définies dans l'environnement ont priorité sur .env.
# Chemins : absolus, ou relatifs à la racine du projet. Un « * » dans le nom
# de fichier choisit le fichier correspondant le plus récent.

# --- Service web ---------------------------------------------------------------
# LOCAL      : http://localhost:3000/financements/{courriel}
#   PORT=3000, HOTE=localhost, URL_PUBLIQUE=http://localhost:3000
#
# PRODUCTION : https://api.bib.umontreal.ca/financements/{courriel}
#   Node écoute seulement en local ; le serveur web (Apache/nginx) d'api.bib.umontreal.ca
#   gère HTTPS et relaie /financements/ vers http://127.0.0.1:3000/financements/
#   PORT=3000, HOTE=127.0.0.1, URL_PUBLIQUE=https://api.bib.umontreal.ca, TRUST_PROXY=loopback
PORT=3000
HOTE=localhost
URL_PUBLIQUE=http://localhost:3000
# Derrière un proxy inverse : loopback (proxy sur la même machine) ou son adresse IP
TRUST_PROXY=
# HTTPS servi directement par Node, seulement s'il n'y a pas de proxy (chemins des fichiers PEM)
HTTPS_CERTIFICAT=
HTTPS_CLE=
# Access-Control-Allow-Origin (vide pour désactiver)
CORS_ORIGINE=*
# Cache-Control des réponses, en secondes
CACHE_MAX_AGE=300

# --- Fichiers d'entrée ---------------------------------------------------------
# Dossier par défaut des fichiers ci-dessous lorsqu'ils ne sont pas précisés
DOSSIER_DONNEES=data
FICHIER_ORGANISME=data/organisme-exemple.xml
FICHIER_PROGRAMME=data/programme-exemple.xml
FICHIER_VITRINE=data/vitrine-exemple.xml
# Laisser vide (FICHIER_SYNCHRO_RH=) = mode développement, sans filtre sur les professeurs
FICHIER_SYNCHRO_RH=data/exemplesynchro_*.txt

# --- Fichier généré et servi par l'API -----------------------------------------
FICHIER_FINANCEMENTS=financements.json
# Nombre d'années maximum depuis la fin du financement
ANNEES=5
# Fuseau horaire de la date « miseAJour » (heure de Montréal)
FUSEAU_HORAIRE=America/Toronto
# Fréquence de vérification de FICHIER_FINANCEMENTS (rechargement automatique)
INTERVALLE_SURVEILLANCE_MS=5000

# Garde-fou : la génération s'arrête si moins de professeurs sont trouvés
MIN_PROFESSEURS=1500
